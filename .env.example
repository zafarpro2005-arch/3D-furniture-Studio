# Шаблон переменных окружения. Скопируйте в .env и заполните локально.
# Файл .env игнорируется git — не коммитьте реальные значения.

# Fine-grained токен GitHub для GitHub MCP (Claude Code).
# В .mcp.json на него можно сослаться так: "Authorization": "Bearer ${GITHUB_PAT}"
GITHUB_PAT=

# Токен доступа к нашему MCP-серверу (mcp-server/, порт 3001). Без него сервер отвечает 401.
MCP_TOKEN=
